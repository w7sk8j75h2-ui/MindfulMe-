
/* GENERAL SETTINGS */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #f7f6ef;
    color: #394b3c;
    font-family: 'DM Sans', sans-serif;
}


/* LEFT SIDEBAR */

.sidebar {
    width: 215px;
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    background: #eeefe5;
    padding: 30px 18px;
    border-right: 1px solid #dedfd3;
    display: flex;
    flex-direction: column;
    z-index: 20;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 29px;
    color: #405943;
    margin: 0 0 40px 12px;
}

.logo span {
    color: #9b9d7e;
}

.nav-btn {
    border: none;
    background: transparent;
    color: #697567;
    text-align: left;
    padding: 14px 12px;
    margin: 4px 0;
    border-radius: 12px;
    cursor: pointer;
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: 0.2s;
}

.nav-btn:hover,
.nav-btn.active {
    background: #dfe6d7;
    color: #405943;
}

.nav-icon {
    font-size: 19px;
}


/* MAIN AREA */

.main-area {
    margin-left: 215px;
    min-height: 100vh;
}

.topbar {
    height: 75px;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
    border-bottom: 1px solid #e5e5db;
    background: #f7f6ef;
    position: sticky;
    top: 0;
    z-index: 10;
}

.search-box {
    width: 260px;
    padding: 11px 17px;
    border: 1px solid #dedfd3;
    border-radius: 25px;
    background: #fffefa;
    outline: none;
}

.top-icon {
    font-size: 20px;
    cursor: pointer;
}

.avatar {
    width: 36px;
    height: 36px;
    background: #dce5d5;
    color: #405943;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: bold;
}

.content {
    max-width: 1300px;
    padding: 35px 40px;
    margin: auto;
}


/* PAGE SETTINGS */

.page {
    display: none;
}

.page.active {
    display: block;
}

h1, h2, h3 {
    font-family: 'Playfair Display', serif;
    font-weight: 500;
}

h1 {
    font-size: 43px;
    margin-bottom: 12px;
}

h2 {
    font-size: 29px;
    margin-bottom: 15px;
}

h3 {
    font-size: 21px;
    margin-bottom: 10px;
}

p {
    color: #738071;
    line-height: 1.7;
}

.small-heading {
    color: #89947f;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.section-title {
    margin: 35px 0 18px;
}


/* BUTTONS AND CARDS */

.btn {
    background: #526b54;
    color: white;
    border: none;
    border-radius: 25px;
    padding: 12px 22px;
    margin-top: 15px;
    cursor: pointer;
}

.btn:hover {
    background: #3d5541;
}

.light-btn {
    background: #e6ebdf;
    color: #405943;
}

.card {
    background: #fffefa;
    border: 1px solid #e7e7dc;
    border-radius: 7px 25px 7px 25px;
    padding: 23px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.icon {
    font-size: 26px;
    margin-bottom: 12px;
}


/* HOME PAGE */

.welcome {
    background: #e7ebdf;
    border-radius: 7px 45px 7px 45px;
    padding: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 28px;
}

.welcome-text {
    max-width: 520px;
}

.welcome h1 {
    font-size: 48px;
}

.welcome-image {
    width: 38%;
    height: 250px;
    object-fit: cover;
    border-radius: 45% 45% 8px 8px;
}

.photo-strip {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 18px;
    margin: 28px 0;
}

.photo-strip img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    border-radius: 5px 30px 5px 30px;
}

.photo-caption {
    background: #e9ecdf;
    padding: 25px;
    border-radius: 5px 25px 5px 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.reminder {
    background: #e8ecdf;
    padding: 25px;
    border-radius: 5px 25px 5px 25px;
    margin-top: 25px;
}

.reminder p {
    font-family: 'Playfair Display', serif;
    font-size: 23px;
    color: #536a54;
}


/* WELLNESS PAGE */

.wellness-image {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 5px 30px 5px 30px;
    margin: 20px 0;
}

.tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0;
}

.tab-btn {
    border: 1px solid #d9dfd2;
    background: #fffefa;
    color: #62715e;
    padding: 10px 17px;
    border-radius: 25px;
    cursor: pointer;
}

.tab-btn.active,
.tab-btn:hover {
    background: #dfe7d8;
    color: #405943;
}

.wellness-layout {
    display: grid;
    grid-template-columns: 1fr 1fr 0.9fr;
    gap: 16px;
    align-items: start;
}

.wellness-panel {
    background: #fffefa;
    border: 1px solid #e7e7dc;
    border-radius: 8px 25px 8px 25px;
    padding: 20px;
}

.activity {
    background: #f0f1e9;
    border-radius: 20px;
    padding: 11px 13px;
    margin-top: 12px;
    font-size: 14px;
}

.activity-message {
    margin-top: 12px;
}

.mood-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 15px 0;
}

.mood-buttons button {
    background: #f0f1e9;
    border: none;
    border-radius: 20px;
    padding: 10px 15px;
    cursor: pointer;
}


/* STUDY PLANNER */

.planner-tabs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 20px 0;
}

.planner-tabs button {
    background: #e8ecdf;
    border: none;
    border-radius: 20px;
    padding: 10px 18px;
    color: #536a54;
    cursor: pointer;
}

.planner-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
}

.calendar-card,
.tasks-card {
    background: #fffefa;
    border: 1px solid #e7e7dc;
    padding: 22px;
    border-radius: 10px 28px 10px 28px;
}

.calendar-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.calendar-heading button {
    background: #e8ecdf;
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    cursor: pointer;
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 7px;
    text-align: center;
}

.day-name {
    font-size: 12px;
    color: #92998b;
    padding: 8px 0;
}

.calendar-day {
    padding: 9px 2px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 13px;
}

.calendar-day:hover {
    background: #e6ebdf;
}

.calendar-day.today {
    background: #536b54;
    color: white;
}

.calendar-day.selected {
    outline: 2px solid #9aa88d;
}

.calendar-day.empty {
    cursor: default;
}

.calendar-help {
    margin-top: 18px;
    font-size: 13px;
}

.task-form {
    margin: 15px 0;
}

.input-box {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #dce0d5;
    background: #fffefa;
    border-radius: 10px;
    margin: 7px 0 13px;
    outline: none;
    color: #405943;
}

.input-box:focus {
    border-color: #8b9c83;
}

label {
    color: #697567;
    font-size: 13px;
}

.task-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #f0f1e9;
    padding: 14px;
    border-radius: 12px;
    margin: 10px 0;
}

.task-info {
    flex: 1;
}

.task-info strong {
    display: block;
    font-size: 14px;
    margin-bottom: 5px;
}

.task-info small {
    color: #7b8776;
    display: block;
    margin-top: 4px;
}

.task-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.task-actions button {
    border: none;
    background: none;
    color: #9b7063;
    cursor: pointer;
}

.task-item.completed .task-info strong {
    text-decoration: line-through;
    color: #92998b;
}

.deadline {
    font-size: 12px;
    background: #e0e7d9;
    color: #526b54;
    padding: 5px 9px;
    border-radius: 15px;
    display: inline-block;
    margin-top: 6px;
}

.task-heading {
    margin-top: 25px;
}


/* NOTES PAGE */

.notes-layout {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 20px;
    margin-top: 25px;
}

.subject-list {
    background: #e9ecdf;
    padding: 20px;
    border-radius: 8px 25px 8px 25px;
}

.subject-btn {
    display: block;
    width: 100%;
    text-align: left;
    border: none;
    background: transparent;
    padding: 11px 5px;
    color: #61705f;
    cursor: pointer;
    border-radius: 8px;
}

.subject-btn:hover,
.subject-btn.active {
    background: #d8e1d2;
    color: #405943;
}

.notes-content {
    min-width: 0;
}

.notes-toolbar {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 15px;
}

.notes-toolbar input {
    flex: 1;
    min-width: 0;
}

.note-form {
    display: none;
    margin-bottom: 20px;
}

.note-card {
    background: #fffefa;
    border: 1px solid #e7e7dc;
    padding: 20px;
    border-radius: 8px 23px 8px 23px;
    margin-bottom: 13px;
    display: flex;
    justify-content: space-between;
    gap: 15px;
}

.note-card small {
    color: #92998b;
}

.note-card button {
    background: none;
    border: none;
    color: #a06f62;
    cursor: pointer;
}


/* RESOURCES */

.resource-card {
    min-height: 160px;
}

.resource-grid {
    margin-top: 25px;
}


/* PROFILE */

.profile-card {
    max-width: 600px;
    margin-top: 25px;
}

.profile-avatar {
    background: #e1e8d9;
    width: 75px;
    height: 75px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 32px;
    margin-bottom: 20px;
}

.edit-heading {
    margin-top: 25px;
}


/* FOOTER */

footer {
    text-align: center;
    padding: 30px;
    color: #92998b;
    font-size: 13px;
    margin-top: 30px;
    border-top: 1px solid #e5e5db;
}


/* TABLET */

@media (max-width: 900px) {

    .sidebar {
        width: 175px;
    }

    .main-area {
        margin-left: 175px;
    }

    .content {
        padding: 25px 20px;
    }

    .wellness-layout {
        grid-template-columns: 1fr 1fr;
    }

    .wellness-panel:last-child {
        grid-column: span 2;
    }

}


/* MOBILE */

@media (max-width: 650px) {

    .sidebar {
        width: 100%;
        height: auto;
        position: relative;
        padding: 12px;
    }

    .logo {
        margin: 0 0 10px;
        text-align: center;
    }

    .sidebar nav {
        display: flex;
        overflow-x: auto;
        gap: 5px;
    }

    .nav-btn {
        flex-direction: column;
        min-width: 75px;
        gap: 3px;
        font-size: 11px;
        padding: 9px 5px;
    }

    .main-area {
        margin-left: 0;
    }

    .topbar {
        height: 60px;
        padding: 0 15px;
    }

    .search-box {
        width: 65%;
    }

    .content {
        padding: 22px 15px;
    }

    .welcome {
        flex-direction: column;
        padding: 25px;
    }

    .welcome-image {
        width: 100%;
        height: 190px;
    }

    .photo-strip,
    .planner-layout,
    .grid,
    .notes-layout {
        grid-template-columns: 1fr;
    }

    .wellness-layout {
        grid-template-columns: 1fr;
    }

    .wellness-panel:last-child {
        grid-column: auto;
    }

    h1 {
        font-size: 36px;
    }

}

